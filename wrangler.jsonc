{
  // TravelMuz Bedbanks — configuration Cloudflare (D-016). Aucun secret ici.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travelmuz-bedbanks",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    // database_id absent : Wrangler crée la base au premier déploiement (provisionnement automatique).
    { "binding": "DB", "database_name": "travelmuz-bedbanks" }
  ],
  "vars": {
    // TBO staging (D-013) ; la production remplacera ces URL en fin de projet.
    "TBO_BASE_URL": "https://api.tbotechnology.in/TBOHolidays_HotelAPI",
    // Offre Workers Paid (validée par l'utilisateur le 4/11) : un lot par minute, accélération manuelle autorisée.
    "CATALOG_CRON_GAP_MIN": "1",
    "CATALOG_FAST": "true"
  },
  // Ne jamais effacer au déploiement les variables saisies dans le tableau de bord Cloudflare.
  "keep_vars": true,
  // Synchronisation du catalogue Halalbooking en arrière-plan (toutes les minutes, s'arrête une fois à jour)
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true
  // Secrets à saisir dans Cloudflare (Paramètres > Variables et secrets), jamais dans ce fichier :
  // HALALBOOKING_PARTNER_CODE, HALALBOOKING_SECRET_KEY, SETUP_CODE, TBO_USERNAME, TBO_PASSWORD
}
